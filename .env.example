# Local environment configuration example for Hyperlofy.
# Copy this file to .env and replace the values before running the app.

# Android / build-time secrets
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Backend service configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/hyperlofy
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
JWT_SECRET=EnterBase64JwtSecretHere
RAZORPAY_KEY_ID=rzp_test_key_id
RAZORPAY_KEY_SECRET=rzp_test_key_secret
